PORT=5000
DATABASE_URL=postgres://USERNAME:PASSWORD@HOST:5432/elders_veil
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:5000
UPLOAD_BASE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5000

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=v25.0

# Production storage (optional)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI adapter
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Optional email/password reset
RESEND_API_KEY=
EMAIL_FROM=

# Optional Razorpay Premium checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PREMIUM_PRICE_INR=199

# Security / scheduling
SCHEDULE_PUBLISH_ENABLED=true
BACKUP_DIR=./backups
