# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=comicverse_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comicverse_db

# Security & Authentication Secrets
JWT_SECRET=super_secret_comicverse_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# File Upload Directory & Limits
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Allowed CORS Origin
CORS_ORIGIN=*
