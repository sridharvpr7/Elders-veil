PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/elders_veil
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Public URL of the backend/frontend application
FRONTEND_URL=http://localhost:5000
UPLOAD_BASE_URL=http://localhost:5000

# Meta WhatsApp Business Cloud API
# NEVER put these secrets in frontend JavaScript or GitHub.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_AUTO_REPLY_ENABLED=false
WHATSAPP_API_VERSION=v26.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_WELCOME_TEMPLATE=elder_veil_welcome
WHATSAPP_NEW_COMIC_TEMPLATE=elder_veil_new_comic
WHATSAPP_NEW_CHAPTER_TEMPLATE=elder_veil_new_chapter

# Admin/user lifecycle WhatsApp templates (must be approved in Meta WhatsApp Manager)
WHATSAPP_ADMIN_PROMOTED_TEMPLATE=elder_veil_admin_promoted
WHATSAPP_ADMIN_REMOVED_TEMPLATE=elder_veil_admin_removed
WHATSAPP_ACCOUNT_DELETED_TEMPLATE=elder_veil_account_deleted
