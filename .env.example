PORT=5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/elders_veil
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

FRONTEND_URL=http://localhost:5000
UPLOAD_BASE_URL=http://localhost:5000

# Email Notification Configuration (Nodemailer / SMTP)
# Render Free blocks outbound SMTP ports 25, 465 and 587.
# For Render Free, use an SMTP provider/plan that supports port 2525.
# Example Brevo SMTP relay:
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=2525
# EMAIL_SECURE=false
# EMAIL_USER=your_brevo_smtp_username
# EMAIL_PASSWORD=your_brevo_smtp_key
# EMAIL_FROM=your_verified_sender@example.com
# EMAIL_FROM_NAME="Elder's Veil"

EMAIL_HOST=smtp.example.com
EMAIL_PORT=2525
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=your_verified_sender@example.com
EMAIL_FROM_NAME="Elder's Veil"
